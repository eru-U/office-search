{
  "name": "@terasu/db",
  "version": "1.0.0",
  "description": "Job hunting management database package for terasu",
  "main": "index.js",
  "scripts": {
    "dev": "pnpm db:pr:studio",
    "db:dc:up": "docker compose up -d",
    "db:dc:down": "docker compose down",
    "db:dc:restart": "docker compose restart",
    "db:dc:logs": "docker compose logs -f",
    "db:dc:clean": "docker compose down -v",
    "db:pr:generate": "prisma generate",
    "db:pr:migrate": "prisma migrate dev",
    "db:pr:studio": "prisma studio",
    "db:pr:reset": "prisma migrate reset",
    "db:pr:deploy": "prisma migrate deploy",
    "db:pr:seed": "prisma db seed"
  },
  "prisma": {
    "seed": "tsx seeds/mod.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.15.0",
  "devDependencies": {
    "@types/node": "^25.0.3",
    "prisma": "6.0.0",
    "tsx": "^4.21.0",
    "zod-prisma-types": "^3.3.10"
  },
  "dependencies": {
    "@prisma/client": "6.0.0",
    "cuid": "^3.0.0",
    "zod": "^4.3.5"
  },
  "exports": {
    ".": "./index.ts",
    "./lib/*": "./lib/*"
  }
}
