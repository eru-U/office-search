{
  "name": "@terasu/root",
  "description": "A project for the Terasu application",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "format": "turbo format",
    "db:up": "pnpm --filter @terasu/db db:dc:up",
    "db:down": "pnpm --filter @terasu/db db:dc:down",
    "db:generate": "pnpm --filter @terasu/db db:pr:generate",
    "db:migrate": "pnpm --filter @terasu/db db:pr:migrate",
    "db:studio": "turbo db:pr:studio",
    "postinstall": "turbo db:pr:generate"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@biomejs/biome": "2.3.6",
    "turbo": "^2.7.3"
  },
  "packageManager": "pnpm@10.15.0",
  "volta": {
    "node": "22.21.1",
    "pnpm": "10.15.0"
  }
}
